<?xml version="1.0" encoding="utf-8"?>
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap mp rescap uap3">

  <!--
    __PACKAGE_IDENTITY_NAME__, __PACKAGE_PUBLISHER__ and
    __PACKAGE_PUBLISHER_DISPLAY_NAME__ are replaced by the build-windows.yml
    workflow using the WINDOWS_PACKAGE_IDENTITY_NAME, WINDOWS_PACKAGE_PUBLISHER
    and WINDOWS_PACKAGE_PUBLISHER_DISPLAY_NAME repository Variables, which you
    copy from Partner Center -> App identity. __PACKAGE_VERSION__ is replaced
    with a build-number-derived version.
  -->
  <Identity
    Name="__PACKAGE_IDENTITY_NAME__"
    Publisher="__PACKAGE_PUBLISHER__"
    Version="__PACKAGE_VERSION__" />

  <!-- mp:PhoneIdentity intentionally removed: it's a legacy Windows Phone
       element, not needed for a WinUI3 Desktop app, and its placeholder
       all-zero GUIDs were causing MakeAppx to reject the manifest as
       invalid (error 0x80080204). -->

  <Properties>
    <DisplayName>StudyBuddyZone</DisplayName>
    <PublisherDisplayName>__PACKAGE_PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="StudyBuddyZone" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="StudyBuddyZone"
        Description="StudyBuddyZone - your all-in-one study companion."
        BackgroundColor="#ffffff"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square310x310Logo="Assets\LargeTile.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#ffffff" />
      </uap:VisualElements>
      <Extensions>
        <!-- Windows App URI Handler: lets Windows launch this app (instead of
             the browser) when someone opens an https://studybuddypro-psi.vercel.app
             link — e.g. a quiz-join.html room link shared on WhatsApp. Requires
             a matching association file hosted at
             https://studybuddypro-psi.vercel.app/.well-known/windows-app-web-link
             (see windows/windows-app-web-link.template in this repo). -->
        <uap3:Extension Category="windows.appUriHandler">
          <uap3:AppUriHandler>
            <uap3:Host Name="studybuddypro-psi.vercel.app" />
          </uap3:AppUriHandler>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
